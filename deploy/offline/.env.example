# Copy to .env and edit as needed.
# All values below are defaults — only set what you need to change.

# Docker image names — override if your images have different tags
# SERVER_IMAGE=openvsx-server:local
# WEBUI_IMAGE=openvsx-webui:local
# POSTGRES_IMAGE=postgres:16.2

# Exposed ports
# SERVER_PORT=8080
# WEBUI_PORT=3000
# POSTGRES_PORT=5432

# Database password
# POSTGRES_PASSWORD=openvsx
